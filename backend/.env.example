# Server-only Google key. Restrict to Routes API, Route Matrix and Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# Server-only Open Charge Map API key.
OPENCHARGEMAP_API_KEY=

# Optional Places bias, e.g. IN. Leave blank for global suggestions.
GOOGLE_REGION_CODE=

# Frontend origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for the Data Console. Generate a long random value.
EV_ADMIN_TOKEN=

# Optional absolute SQLite path. Defaults to backend/evchargeroute.db.
EV_DB_PATH=
